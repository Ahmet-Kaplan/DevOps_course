# =============================================================================
# .env.example - LOCAL DEVELOPMENT template
# -----------------------------------------------------------------------------
# This file is OPTIONAL. `docker compose up --build` works without any .env
# file because every variable in docker-compose.yml has a ${VAR:-default}.
#
# To override something locally:
#     cp .env.example .env      # .env is git-ignored, never commit it
#
# Docker Compose automatically reads a file called ".env" in the project
# directory and uses it for ${VARIABLE} interpolation inside docker-compose.yml.
# (It is NOT automatically injected into containers - the compose file decides
#  which variables each container receives via its `environment:` block.)
#
# For PRODUCTION use .env.prod.example instead.
# =============================================================================

# ---- PostgreSQL ---------------------------------------------------------------
# The official postgres image creates this database + user on FIRST start only
# (when the data volume is empty). Changing them later requires `docker compose
# down -v` to wipe the volume - a nice lesson in "volumes outlive containers".
POSTGRES_DB=bugsquash
POSTGRES_USER=bugsquash
POSTGRES_PASSWORD=bugsquash-dev-password

# Host port Postgres is published on (bound to 127.0.0.1 only), so you can
# connect with psql / DBeaver / pgAdmin from your laptop:
#     psql "postgresql://bugsquash:bugsquash-dev-password@localhost:5432/bugsquash"
# Change it if you already run a local Postgres on 5432.
POSTGRES_HOST_PORT=5432

# ---- Backend (Express API) ----------------------------------------------------
# Any string works in development. In production this MUST be a long random
# value (see .env.prod.example) - whoever knows it can forge login cookies.
JWT_SECRET=dev-only-insecure-secret-change-me

# How long a login stays valid (jsonwebtoken / "ms" format: 60s, 15m, 12h, 7d).
JWT_EXPIRES_IN=7d

# The "Secure" cookie flag makes the browser send the cookie over HTTPS only.
# The dev stack is plain HTTP, so keep it false (some browsers, and every
# non-localhost address such as your LAN IP, drop Secure cookies over HTTP).
COOKIE_SECURE=false

# Max signup/login attempts per IP per 15 minutes (brute-force protection).
AUTH_RATE_LIMIT_MAX=30

# Shown in the page footer and in GET /api/health.
APP_VERSION=dev

# ---- Frontend (Vite dev server) -----------------------------------------------
# File-change events do not always cross the VM boundary of Docker Desktop
# (macOS / Windows). Set to true if hot reload does not pick up your edits.
# Linux users can leave it false (inotify works natively, polling costs CPU).
VITE_USE_POLLING=false
