# =============================================================================
# .env.prod.example - PRODUCTION settings template (Google Cloud VM)
# -----------------------------------------------------------------------------
# Create the real file on your LAPTOP, next to docker-compose.prod.yml:
#     cp .env.prod.example .env.prod
#     chmod 600 .env.prod          # only you may read the secrets
#     nano .env.prod               # fill in every value marked REQUIRED
# then copy it to the server together with the rest of the bundle. Once, on
# the VM:   sudo mkdir -p /opt/devops-workshop/deploy
#           sudo chown -R "$USER": /opt/devops-workshop
# From the repository root on your laptop (again after every change):
#     scp docker-compose.prod.yml .env.prod <user>@<VM-IP>:/opt/devops-workshop/
#     scp -r deploy/nginx <user>@<VM-IP>:/opt/devops-workshop/deploy/
# (from stage 3 on, copy the whole folder instead - it adds tls.sh, deploy.sh
#  and the renewal timer:  scp -r deploy <user>@<VM-IP>:/opt/devops-workshop/ )
# and on the VM:  chmod 600 /opt/devops-workshop/.env.prod
# (In stage 5, Ansible renders this file from its encrypted vault instead.)
#
# .env.prod is git-ignored - never commit it. It is passed explicitly on every
# command (deploy/deploy.sh and deploy/tls.sh do the same for you):
#     docker compose -f docker-compose.prod.yml --env-file .env.prod <command>
#
# Variables marked REQUIRED use ${VAR:?message} in docker-compose.prod.yml:
# Compose refuses to start and prints the message if they are missing or empty.
# "Fail fast at deploy time" beats "silently run with an empty password".
#
# Generate strong secrets with:
#     openssl rand -hex 32         # 64 hex chars = 256 bits of randomness
# Hex output is used on purpose: no "$", "#", quotes or "/" that could break
# .env parsing, a shell, or a postgres:// connection URL.
#
# What changes per workshop stage (everything else stays as you set it once):
#   stage 1  IP + HTTP       DOMAIN empty,             COOKIE_SECURE=false
#   stage 2  domain + HTTP   DOMAIN=<your domain>,     COOKIE_SECURE=false
#   stage 3+ HTTPS           DOMAIN=<your domain>,     COOKIE_SECURE=true
# After editing: copy the file to the server again and run `... up -d`.
# =============================================================================

# ---- Docker Hub / image selection ---------------------------------------------
# REQUIRED. The Docker Hub account the ci-main workflow pushes to. Compose pulls
#   ${DOCKER_HUB_USERNAME}/bugsquash-backend:${IMAGE_TAG}
#   ${DOCKER_HUB_USERNAME}/bugsquash-frontend:${IMAGE_TAG}
# Workshop: the course images are public under "alhuraibisaeed" - use that
# unless you build and push your own images with your own fork's CI.
DOCKER_HUB_USERNAME=your-dockerhub-username

# Which image tag to run. "latest" = newest build of main.
# Pin an immutable tag such as "sha-1a2b3c4" for reproducible deploys/rollbacks.
# Tip: `./deploy/deploy.sh sha-1a2b3c4` overrides this value for one deploy
# (a variable exported in the shell wins over the --env-file value).
IMAGE_TAG=latest

# ---- Public name of the site (stage 2+) ------------------------------------------
# The host name your DNS A record points at the VM, e.g. devops.gulfheight.com
# (no "http://", no trailing slash).
#   stage 1: leave EMPTY - the site answers on http://<VM external IP>.
#   stage 2: set it; the proxy then also answers on http://<DOMAIN>.
#   stage 3: the Let's Encrypt certificate is requested for exactly this name,
#            and once it exists the proxy switches to HTTPS for it.
DOMAIN=

# Optional (stage 3, used by deploy/tls.sh): e-mail for your Let's Encrypt
# account, e.g. for account-recovery notices. Empty = register without an
# address (Let's Encrypt stopped sending expiry reminder e-mails in 2025, and
# renewal is automatic anyway).
LETSENCRYPT_EMAIL=

# ---- PostgreSQL ---------------------------------------------------------------
# Used by the postgres container on FIRST start (empty volume) to create the
# database and user, and handed to the backend as PGDATABASE/PGUSER/PGPASSWORD.
POSTGRES_DB=bugsquash
POSTGRES_USER=bugsquash
# REQUIRED. Generate with: openssl rand -hex 32
# Note: changing it later does NOT change the password stored inside an existing
# data volume - run ALTER USER inside psql as well, or the backend cannot log in.
POSTGRES_PASSWORD=

# ---- Backend (Express API) ----------------------------------------------------
# REQUIRED. Signs the login JWTs. Generate with: openssl rand -hex 32
# Rotating it logs every user out (old tokens no longer verify) - that is a
# feature when a secret leaks.
JWT_SECRET=

# Lifetime of a login session (60s, 15m, 12h, 7d ...).
JWT_EXPIRES_IN=7d

# "Secure" flag on the login cookie = the browser only sends it over HTTPS.
#   stages 1-2 (plain HTTP): false - browsers DROP a Secure cookie that arrives
#                            over http://, so every login would seem to "not
#                            stick" (you are logged out on the next page).
#   stage 3+   (HTTPS):      true  - change it, copy the file again, `up -d`
#                            (Compose recreates the backend with the new value).
# deploy/deploy.sh warns when this value does not match the proxy's mode.
COOKIE_SECURE=false

# Max signup/login requests per client IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=30
