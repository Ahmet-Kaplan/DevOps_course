# =============================================================================
# .env.prod - rendered by Ansible (ansible/roles/app/templates/env.prod.j2)
# -----------------------------------------------------------------------------
# Edits made here by hand are overwritten on the next ./ansible/provision.sh run.
# Change the source instead:
#   settings  ansible/group_vars/all.yml
#   secrets   ansible/secrets/vault.yml   (ansible-vault edit ...)
# Every variable is explained in .env.prod.example.
# =============================================================================

DOCKER_HUB_USERNAME={{ docker_hub_username }}
IMAGE_TAG={{ image_tag }}

DOMAIN={{ domain }}
LETSENCRYPT_EMAIL={{ letsencrypt_email }}

POSTGRES_DB={{ postgres_db }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ vault_postgres_password }}

JWT_SECRET={{ vault_jwt_secret }}
JWT_EXPIRES_IN={{ app_jwt_expires_in }}

# Computed by Ansible: true only if a certificate for {{ domain | default('the domain', true) }} exists,
# because browsers drop a Secure cookie that arrives over plain http://.
COOKIE_SECURE={{ app_cookie_secure | bool | lower }}

AUTH_RATE_LIMIT_MAX={{ app_auth_rate_limit_max }}
